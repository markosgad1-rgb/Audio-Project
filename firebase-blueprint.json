{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Construction site project attendance code and details",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Project code for biometric attendance",
          "maxLength": 64
        },
        "nameAr": {
          "type": "string",
          "description": "Arabic project name",
          "maxLength": 256
        },
        "nameEn": {
          "type": "string",
          "description": "English project name",
          "maxLength": 256
        },
        "notes": {
          "type": "string",
          "description": "Additional notes such as gate or shift",
          "maxLength": 512
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether project is pinned to the top"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "createdBy": {
          "type": "string",
          "description": "UID or email of creator",
          "maxLength": 128
        }
      },
      "required": ["code", "nameAr"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role permission",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Role: admin or viewer",
          "enum": ["admin", "viewer"]
        },
        "createdAt": {
          "type": "number",
          "description": "Account creation timestamp"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Shared project codes for attendance"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User role management"
    }
  }
}
